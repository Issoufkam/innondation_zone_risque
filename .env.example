# Clés S3 (Object Storage) du compte Copernicus Data Space Ecosystem.
# À générer sur https://eodata-s3keysmanager.dataspace.copernicus.eu/
# (section "Add Credentials" — la Secret Key n'est affichée qu'une fois).
# Copier ce fichier en .env et renseigner les valeurs (jamais commité).
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=
